import numpy as np

# XOR Training Dataset
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

Y = np.array([
    [0],
    [1],
    [1],
    [0]
])

# Initialize weights and bias
np.random.seed(42)

W1 = np.random.rand(2, 3)
b1 = np.zeros((1, 3))

W2 = np.random.rand(3, 1)
b2 = np.zeros((1, 1))

# Sigmoid activation function
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

# Derivative of sigmoid
def sigmoid_derivative(x):
    return x * (1 - x)

# Training
learning_rate = 0.5
epochs = 10000

for epoch in range(epochs):

    # Forward propagation
    hidden_input = np.dot(X, W1) + b1
    hidden_output = sigmoid(hidden_input)

    final_input = np.dot(hidden_output, W2) + b2
    output = sigmoid(final_input)

    # Backpropagation
    error = Y - output

    d_output = error * sigmoid_derivative(output)

    error_hidden = d_output.dot(W2.T)
    d_hidden = error_hidden * sigmoid_derivative(hidden_output)

    # Update weights and bias
    W2 += learning_rate * hidden_output.T.dot(d_output)
    b2 += learning_rate * np.sum(d_output, axis=0, keepdims=True)

    W1 += learning_rate * X.T.dot(d_hidden)
    b1 += learning_rate * np.sum(d_hidden, axis=0, keepdims=True)

# Testing
print("ANN Backpropagation Results:")

for i in range(len(X)):
    hidden = sigmoid(np.dot(X[i], W1) + b1)
    predicted = sigmoid(np.dot(hidden, W2) + b2)

    print("Input:", X[i],
          "Output:", round(predicted[0][0], 3),
          "Prediction:", round(predicted[0][0]))



     
